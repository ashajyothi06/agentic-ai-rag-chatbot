# =========================
# LLM: choose qwen or grok
# =========================
LLM_PROVIDER=qwen

# Qwen / Alibaba Cloud Model Studio
QWEN_API_KEY=api_key
# This international endpoint is easy to start with.
# You can replace it with your workspace-specific Singapore compatible-mode URL.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus



# =========================
# Pinecone
# =========================
PINECONE_API_KEY=pinecone_key
PINECONE_INDEX_NAME=agentic-ai-ebook
PINECONE_NAMESPACE=ebook-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# =========================
# Embeddings / retrieval
# =========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
MIN_SIMILARITY=0.25
MIN_GROUNDING_SCORE=0.75
MAX_GENERATION_ATTEMPTS=2

# =========================
# Source PDF
# =========================
SOURCE_PDF_URL=https://konverge.ai/pdf/Ebook-Agentic-AI.pdf
SOURCE_PDF_PATH=data/Ebook-Agentic-AI.pdf

# Streamlit calls FastAPI at this URL
RAG_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
